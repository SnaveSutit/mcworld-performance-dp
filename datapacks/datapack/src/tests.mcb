# BEFORE MAKING YOUR TEST, Please create a fork, and a branch on that fork called `test-<your-test-comparison>`.
# For example: `test-entity-relation-vs-macros`
# This way I can easily merge it into the main repo, and it will be easy to find and swap out for other users.

function settings {
	# How many ticks to run the tests for. Higher values provide more accurate data, but take longer. (Default: 1200)
	# At 1200 (about 60 seconds per test at 50ms/t) there is a +-0.1% margin of error.
	# At 20 (about a second per test at 50ms/t) there is a +-3.00% margin of error.
	# scoreboard players set .tick_count v 1200
	scoreboard players set .tick_count v 600
	# Maximum time to use per tick (Default/Max 50).
	scoreboard players set .max_ms_per_tick v 50
	# The name of the first test. This is used to identify the test in the results.
	data modify storage perf_tool:ram test_a_name set value {text: "Scoreboard ID"}
	# The name of the second test. This is used to identify the test in the results.
	data modify storage perf_tool:ram test_b_name set value {text: "Macro UUID"}
}

dir a {
	function test {
		# Everything ran from this function will count towards the time spent on the test.
		REPEAT(1, 100) as i {
			scoreboard players set #temp testa <%i%>
			execute as @e[type=marker,distance=..10,tag=testa] if score @s testa = #temp testa run \
				scoreboard players add @s testa 0
		}
	}

	dir test {
		# Any extra functions required for test can be put here
	}

	function setup {
		# This function will be run before the performance test begins.
		scoreboard objectives add testa dummy
		REPEAT(1, 100) {
			summon marker ~ ~ ~ {Tags:['testa']}
		}
		scoreboard players set #temp testa 0
		execute as @e[tag=testa] store result score @s testa run scoreboard players add #temp testa 1
	}

	function cleanup {
		# This function will be run after the performance test ends.
		scoreboard objectives remove testa
		kill @e[tag=testa]
	}
}

dir b {
	function test {
		# Everything ran from this function will count towards the time spent on the test.
		block { with storage testb:temp uuids
			REPEAT(1, 100) as i {
				$execute as $(<%i%>) run scoreboard players add @s testb 0
			}
		}
	}

	dir test {
		# Any extra functions required for test can be put here
	}

	function setup {
		# This function will be run before the performance test begins.
		scoreboard objectives add testb dummy
		REPEAT(1, 100) as i {
			execute summon marker run {
				tag @s add testb
				function gu:convert_uuid_array_to_string
				data modify storage testb:temp uuids.<%i%> set from storage gu:uuid main.out
			}
		}
	}

	function cleanup {
		# This function will be run after the performance test ends.
		scoreboard objectives remove testb
		kill @e[tag=testb]
		data remove storage testb:temp uuids
	}
}
